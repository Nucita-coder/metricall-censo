{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/webhook/whatsapp",
      "destination": "/api/webhook/whatsapp.js"
    },
    {
      "source": "/api/soporte",
      "destination": "/api/soporte.js"
    },
    {
      "source": "/api/notificar_pago",
      "destination": "/api/notificar_pago.js"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
